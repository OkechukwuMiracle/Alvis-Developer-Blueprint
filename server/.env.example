SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server-only: seed, private media handlers, and durable worker
SUPABASE_SERVICE_ROLE_KEY=
# Seed/test accounts live outside this repository
ALVIS_SEED_ACCOUNTS_FILE=
ALVIS_E2E_ACCOUNTS_FILE=
# Server-only OpenAI API project credentials and explicitly chosen text model
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=YOUR_STRUCTURED_OUTPUT_MODEL
# Segment timestamps are required; incompatible transcription models fail closed
OPENAI_MODEL_STT=whisper-1
# Dashboard -> Storage -> S3 configuration; all credentials stay on server
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
ALVIS_STORAGE_BUCKET=alvis-recordings
# Optional absolute binary paths; otherwise worker uses PATH
FFMPEG_PATH=
FFPROBE_PATH=
# Optional live test inputs: real training recording and expert-authored answers, outside Git
ALVIS_LIVE_RECORDING=
ALVIS_LIVE_DEBRIEF_FILE=

# Separate embedding model; vector column and provider output must match 1536 dimensions
OPENAI_MODEL_EMBED=text-embedding-3-small
# Public registration / email links. Set to the exact web origin, without a trailing path.
ALVIS_SITE_URL=http://127.0.0.1:3000
# At least 32 random characters, used only to sign short-lived recovery proof cookies.
ALVIS_AUTH_FLOW_SECRET=
# Organization invitation mail. Supabase Auth SMTP is configured separately in its dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
# Designated nonproduction demo workspace only; required by demo reset.
ALVIS_DEMO_ORGANIZATION_ID=
ALVIS_DEPLOYMENT_ENV=development

SERVER_PORT=4000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Optional shared parent domain for same-site subdomain deployment; blank for localhost/reverse proxy.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# Personal/community accounts reuse these server integrations; apply migrations 013–017.
# No community roles, service keys or private storage settings belong in client configuration.
# Optional password for the fixed localhost-only disposable SQL test databases.
# ALVIS_LOCAL_TEST_DB_PASSWORD=
